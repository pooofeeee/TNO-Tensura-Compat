      "id": "lm:skeloraptor",
      "reason": "Clarify wording of already reviewed rider speed attribute; no new behavior.",
      "behavior_replacements": [
        {
          "before": "ATTACK movement attribute+.1",
          "after": "MOVEMENT_SPEED attribute+.1"
