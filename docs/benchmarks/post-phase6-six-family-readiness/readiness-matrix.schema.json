{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkpoint", "source_baseline", "classification_note", "families"],
  "properties": {
    "schema": {"const": "tno.post_phase6.readiness.matrix.v1"},
    "checkpoint": {"const": "R2"},
    "source_baseline": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "classification_note": {"type": "string", "minLength": 1},
    "families": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "native_path_status", "native_path", "mechanical_status", "stage_status", "stage_eligible", "deliberately_unscaled", "resource_channel", "source_identity", "production_status", "research_disposition", "endgame_status", "balance_status", "known_limitations", "native_defenses", "l2_interaction", "runtime_evidence", "evidence_sources", "superseded_findings", "phase7_blocker", "blocker_reason", "confidence"],
        "properties": {
          "family": {"enum": ["MAGIC", "HOLY", "SOUL", "ELEMENTAL", "ENERGY_STEAL", "SEVERANCE"]},
          "native_path_status": {"enum": ["VALID", "INVALID", "UNRESOLVED"]},
          "native_path": {"type": "string", "minLength": 1},
          "mechanical_status": {"enum": ["VALID", "DEFECT_PROVEN", "UNRESOLVED"]},
          "stage_status": {"type": "string", "minLength": 1},
          "stage_eligible": {"$ref": "#/$defs/strings"},
          "deliberately_unscaled": {"$ref": "#/$defs/strings"},
          "resource_channel": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["HP", "SHP", "AURA", "MAGICULES", "WOUND_HEALING_CEILING", "NATIVE_UTILITY"]}},
          "source_identity": {"type": "string", "minLength": 1},
          "production_status": {"enum": ["PRODUCTION_READY", "PRODUCTION_READY_WITH_NATIVE_LIMITATIONS", "IMPLEMENTED_BUT_ENDGAME_LIMITED", "RESEARCH_CLOSED_NO_FIX", "REJECTED_ARCHITECTURE", "UNRESOLVED_BLOCKER"]},
          "research_disposition": {"type": "string", "minLength": 1},
          "endgame_status": {"type": "string", "minLength": 1},
          "balance_status": {"type": "string", "minLength": 1},
          "known_limitations": {"$ref": "#/$defs/strings"},
          "native_defenses": {"type": "object", "additionalProperties": false, "required": ["resistance", "nullification", "special_gates", "coverage"], "properties": {"resistance": {"type": "string", "minLength": 1}, "nullification": {"type": "string", "minLength": 1}, "special_gates": {"$ref": "#/$defs/strings"}, "coverage": {"type": "string", "minLength": 1}}},
          "l2_interaction": {"type": "string", "minLength": 1},
          "runtime_evidence": {"type": "object", "additionalProperties": false, "required": ["scope", "counts", "observations"], "properties": {"scope": {"type": "string", "minLength": 1}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "observations": {"$ref": "#/$defs/strings"}}},
          "evidence_sources": {"$ref": "#/$defs/strings"},
          "superseded_findings": {"$ref": "#/$defs/strings"},
          "phase7_blocker": {"enum": ["YES", "NO", "OWNER_DECISION_REQUIRED"]},
          "blocker_reason": {"type": "string", "minLength": 1},
          "confidence": {"type": "object", "additionalProperties": false, "required": ["mechanical", "endgame", "balance"], "properties": {"mechanical": {"type": "string", "minLength": 1}, "endgame": {"type": "string", "minLength": 1}, "balance": {"type": "string", "minLength": 1}}}
        }
      }
    }
  },
  "$defs": {"strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
