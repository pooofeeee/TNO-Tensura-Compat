{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "checkpoint", "historical_files_rewritten", "findings"],
  "properties": {
    "schema": {"const": "tno.post_phase6.readiness.supersession.v1"}, "checkpoint": {"const": "R1"}, "historical_files_rewritten": {"const": false},
    "findings": {"type": "array", "minItems": 9, "maxItems": 9, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "old_conclusion", "why_incomplete", "new_conclusion", "old_sources", "new_sources"],
      "properties": {
        "id": {"enum": ["SOUL_OBSERVATION_CHANNEL", "ELEMENTAL_COLLISION_DISPATCH", "ENERGY_EMPTY_WORLD_ADMISSION", "SEVERANCE_ADMISSION_RELIABILITY", "REGENERATE_STATE_C_GATE", "CANDIDATE_C_VIABILITY_EXHAUSTED", "MAGIC_HOLY_STAGE_ONLY_POLICY", "GROSS_TTK_IS_NOT_SUSTAINED_KILL", "ENERGY_GAIN_CAPS"]},
        "old_conclusion": {"type": "string", "minLength": 1}, "why_incomplete": {"type": "string", "minLength": 1}, "new_conclusion": {"type": "string", "minLength": 1},
        "old_sources": {"$ref": "#/$defs/paths"}, "new_sources": {"$ref": "#/$defs/paths"}
      }
    }}
  },
  "$defs": {"paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(docs|src)/"}}}
}
