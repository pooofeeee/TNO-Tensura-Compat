{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "checkpoint", "source_baseline", "recovery", "hash_semantics", "commits", "artifacts", "native_authority", "decision_artifacts", "coverage_notes"],
  "properties": {
    "schema": {"const": "tno.post_phase6.readiness.provenance.v1"}, "checkpoint": {"const": "R1"}, "source_baseline": {"$ref": "#/$defs/sha"},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["working_tree", "fetched", "live_energy_sha", "newer_energy_work", "readiness_work_found", "new_branch", "applicable_agents", "original_phase7"], "properties": {"working_tree": {"const": "CLEAN"}, "fetched": {"const": true}, "live_energy_sha": {"$ref": "#/$defs/sha"}, "newer_energy_work": {"const": false}, "readiness_work_found": {"const": false}, "new_branch": {"const": "post-phase6-six-family-readiness-assessment"}, "applicable_agents": {"type": "string", "minLength": 1}, "original_phase7": {"const": "NOT_STARTED"}}},
    "hash_semantics": {"type": "string", "minLength": 1},
    "commits": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["branch", "commit", "ancestor_of_source_baseline"], "properties": {"branch": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/sha"}, "ancestor_of_source_baseline": {"const": true}}}},
    "artifacts": {"type": "array", "minItems": 157, "maxItems": 157, "items": {"type": "object", "additionalProperties": false, "required": ["path", "revision", "git_blob_sha1", "git_blob_sha256", "role"], "properties": {"path": {"type": "string", "pattern": "^(docs|src)/"}, "revision": {"$ref": "#/$defs/sha"}, "git_blob_sha1": {"$ref": "#/$defs/sha"}, "git_blob_sha256": {"$ref": "#/$defs/sha256"}, "role": {"enum": ["production_source", "accepted_document_with_checkpoint_history", "historical_interpretation_requires_supersession_map", "accepted_or_supporting_artifact_read_in_checkpoint_context"]}}}},
    "native_authority": {"type": "object", "additionalProperties": false, "required": ["tensura_version", "jar_sha256", "authority", "l2_version", "native_runtime_repeated"], "properties": {"tensura_version": {"const": "2.0.1.1"}, "jar_sha256": {"$ref": "#/$defs/sha256"}, "authority": {"type": "string", "minLength": 1}, "l2_version": {"const": "3.0.18"}, "native_runtime_repeated": {"const": false}}},
    "decision_artifacts": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["family", "path", "kind"], "properties": {"family": {"enum": ["MAGIC", "HOLY", "SOUL", "ELEMENTAL", "ENERGY_STEAL", "SEVERANCE", "CANDIDATE_C_OPTIONAL_ARCHITECTURE", "REGENERATE_COUNTER_PROTOCOL"]}, "path": {"type": "string", "pattern": "^docs/"}, "kind": {"enum": ["JSON", "DOCUMENT_AND_P5_RAW", "DOCUMENT_AND_R5_RAW"]}, "field": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"kind": {"const": "JSON"}}}, "then": {"required": ["field", "expected"]}, "else": {"required": ["note"]}}]}},
    "coverage_notes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
