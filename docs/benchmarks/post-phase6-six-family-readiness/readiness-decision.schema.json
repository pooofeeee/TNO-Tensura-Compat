{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "checkpoint", "status", "decision", "source_baseline", "branch", "prior_checkpoint_shas", "final_checkpoint_locator", "six_family_summary", "readiness_matrix_reference", "superseded_findings_reference", "non_interaction_review_reference", "basis", "engineering_blockers", "owner_decisions", "remaining_limits", "closed_findings", "candidate_c", "production_changed", "historical_evidence_changed", "phase7_started", "phase7_authorized", "new_runtime_experiments", "stop_for_owner_review", "exact_next_task", "validation_artifacts"],
  "properties": {
    "schema": {"const": "tno.post_phase6.readiness.decision.v1"}, "checkpoint": {"const": "R4"}, "status": {"const": "COMPLETE"},
    "decision": {"enum": ["POST_PHASE6_READY_FOR_PHASE7", "POST_PHASE6_READY_WITH_OWNER_DECISIONS", "POST_PHASE6_NOT_READY_BLOCKED", "POST_PHASE6_ASSESSMENT_INCONCLUSIVE"]},
    "source_baseline": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "branch": {"const": "post-phase6-six-family-readiness-assessment"},
    "prior_checkpoint_shas": {"type": "object", "additionalProperties": false, "required": ["R1", "R2", "R3"], "properties": {"R1": {"$ref": "#/$defs/sha"}, "R2": {"$ref": "#/$defs/sha"}, "R3": {"$ref": "#/$defs/sha"}}},
    "final_checkpoint_locator": {"type": "string", "minLength": 1}, "basis": {"$ref": "#/$defs/strings"},
    "readiness_matrix_reference": {"const": "readiness-matrix.json"}, "superseded_findings_reference": {"const": "supersession-map.json"}, "non_interaction_review_reference": {"const": "non-interaction-review.json"},
    "six_family_summary": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["family", "mechanical_status", "stage_status", "production_status", "endgame_status", "known_limitations", "phase7_blocker"], "properties": {
      "family": {"enum": ["MAGIC", "HOLY", "SOUL", "ELEMENTAL", "ENERGY_STEAL", "SEVERANCE"]}, "mechanical_status": {"enum": ["VALID", "DEFECT_PROVEN", "UNRESOLVED"]}, "stage_status": {"type": "string", "minLength": 1}, "production_status": {"enum": ["PRODUCTION_READY", "PRODUCTION_READY_WITH_NATIVE_LIMITATIONS", "IMPLEMENTED_BUT_ENDGAME_LIMITED", "RESEARCH_CLOSED_NO_FIX", "REJECTED_ARCHITECTURE", "UNRESOLVED_BLOCKER"]}, "endgame_status": {"type": "string", "minLength": 1}, "known_limitations": {"$ref": "#/$defs/strings"}, "phase7_blocker": {"enum": ["YES", "NO", "OWNER_DECISION_REQUIRED"]}
    }}},
    "engineering_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owner_decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "family", "decision_required", "why_owner", "state", "if_accepted", "if_not_accepted"], "properties": {"id": {"type": "string", "minLength": 1}, "family": {"enum": ["MAGIC", "HOLY", "SOUL", "ELEMENTAL", "ENERGY_STEAL", "SEVERANCE", "GLOBAL"]}, "decision_required": {"type": "string", "minLength": 1}, "why_owner": {"type": "string", "minLength": 1}, "state": {"const": "PENDING_OWNER_ACCEPTANCE"}, "if_accepted": {"type": "string", "minLength": 1}, "if_not_accepted": {"type": "string", "minLength": 1}}}},
    "remaining_limits": {"$ref": "#/$defs/strings"}, "closed_findings": {"$ref": "#/$defs/strings"}, "candidate_c": {"const": "REJECTED_EXHAUSTED"},
    "production_changed": {"const": false}, "historical_evidence_changed": {"const": false}, "phase7_started": {"const": false}, "phase7_authorized": {"const": false},
    "new_runtime_experiments": {"const": 0}, "stop_for_owner_review": {"const": true},
    "exact_next_task": {"type": "string", "minLength": 1}, "validation_artifacts": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
